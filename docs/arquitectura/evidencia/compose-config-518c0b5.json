{
  "name": "sapi-h3-518c0b5",
  "networks": {
    "sapi-v2-net": {
      "name": "sapi-h3-518c0b5_sapi-v2-net",
      "driver": "bridge",
      "ipam": {}
    }
  },
  "services": {
    "backend": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "SAPI_FLYWAY_LOCATIONS": "filesystem:/app/db/migration",
        "SAPI_ML_BASE_URL": "http://ml-api:8000",
        "SAPI_ML_CONNECT_TIMEOUT": "2s",
        "SAPI_ML_READ_TIMEOUT": "60s",
        "SAPI_PERSISTENCE_ALLOWED_FIRMS_ORIGINS": "current,reproducibility",
        "SAPI_PERSISTENCE_ENABLED": "true",
        "SPRING_CONFIG_IMPORT": "configtree:/run/sapi-secrets/",
        "SPRING_DATASOURCE_PASSWORD": "$${db_password}",
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://db-v2:5432/sapi_v2",
        "SPRING_DATASOURCE_USERNAME": "sapi",
        "SPRING_FLYWAY_FAILONMISSINGLOCATIONS": "true"
      },
      "networks": {
        "sapi-v2-net": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "./db/migration",
          "target": "/app/db/migration",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "sapi_v2_secrets",
          "target": "/run/sapi-secrets",
          "read_only": true,
          "volume": {}
        }
      ],
      "build": {
        "context": "./services/backend",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "db-v2": {
          "condition": "service_healthy",
          "required": true
        },
        "ml-api": {
          "condition": "service_started",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "--noproxy",
          "*",
          "-o",
          "/dev/null",
          "http://127.0.0.1:8080/health"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 6,
        "start_period": "1m0s"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "18080",
          "protocol": "tcp"
        }
      ]
    },
    "db-v2": {
      "command": [
        "postgres"
      ],
      "entrypoint": [
        "sh",
        "-ec",
        "secret=/run/sapi-secrets/db_password\nif [ ! -s \"$$secret\" ]; then\n  if [ -s \"$$PGDATA/PG_VERSION\" ] && [ -z \"$$SAPI_DB_PASSWORD_SEED\" ]; then\n    echo \"sapi-db-secret: la base persistente ya existe y el volumen sapi_v2_secrets no tiene su contraseña; no se genera otra. Restaurar el volumen o definir SAPI_DB_PASSWORD con la contraseña original.\" >&2\n    exit 1\n  fi\n  umask 077\n  tmp=$$(mktemp /run/sapi-secrets/.db_password.XXXXXX)\n  if [ -n \"$$SAPI_DB_PASSWORD_SEED\" ]; then\n    printf '%s' \"$$SAPI_DB_PASSWORD_SEED\" > \"$$tmp\"\n    origin=\"SAPI_DB_PASSWORD\"\n  else\n    head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40 > \"$$tmp\"\n    origin=\"generada al azar\"\n  fi\n  if [ ! -s \"$$tmp\" ]; then\n    echo \"sapi-db-secret: no se pudo escribir la contraseña.\" >&2\n    exit 1\n  fi\n  chown 999:999 \"$$tmp\"\n  chmod 0440 \"$$tmp\"\n  mv \"$$tmp\" \"$$secret\"\n  echo \"sapi-db-secret: contraseña de la base inicializada ($$origin).\"\nelif [ -n \"$$SAPI_DB_PASSWORD_SEED\" ] && [ \"$$(cat \"$$secret\")\" != \"$$SAPI_DB_PASSWORD_SEED\" ]; then\n  echo \"sapi-db-secret: SAPI_DB_PASSWORD no coincide con la contraseña guardada en sapi_v2_secrets; no se reemplaza.\" >&2\n  exit 1\nelse\n  echo \"sapi-db-secret: se reutiliza la contraseña guardada.\"\nfi\nchown 999:999 /run/sapi-secrets\nchmod 0750 /run/sapi-secrets\nunset SAPI_DB_PASSWORD_SEED\nexec docker-entrypoint.sh \"$$@\"\n",
        "sapi-db-secret"
      ],
      "environment": {
        "POSTGRES_DB": "sapi_v2",
        "POSTGRES_PASSWORD_FILE": "/run/sapi-secrets/db_password",
        "POSTGRES_USER": "sapi",
        "SAPI_DB_PASSWORD_SEED": ""
      },
      "image": "postgis/postgis:15-3.4",
      "networks": {
        "sapi-v2-net": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "sapi_v2_pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "sapi_v2_secrets",
          "target": "/run/sapi-secrets",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -h 127.0.0.1 -p 5432 -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 12,
        "start_period": "20s"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "15432",
          "protocol": "tcp"
        }
      ]
    },
    "ml-api": {
      "command": [
        "uvicorn",
        "services.ml_api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--workers",
        "2"
      ],
      "entrypoint": null,
      "environment": {
        "SAPI_REPRODUCIBILITY_MODE": "1"
      },
      "networks": {
        "sapi-v2-net": null
      },
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile.ml-api"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import sys, urllib.request as u; r = u.build_opener(u.ProxyHandler({})).open('http://127.0.0.1:8000/health', timeout=4); sys.exit(0 if r.status == 200 else 1)"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 6,
        "start_period": "30s"
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8000,
          "published": "18000",
          "protocol": "tcp"
        }
      ]
    },
    "web-v2": {
      "profiles": [
        "presentation"
      ],
      "command": [
        "python",
        "-m",
        "streamlit",
        "run",
        "app/app.py",
        "--server.port=8501",
        "--server.address=0.0.0.0",
        "--theme.base=dark",
        "--theme.primaryColor=#6b9fd4",
        "--theme.backgroundColor=#14171b",
        "--theme.secondaryBackgroundColor=#1c2128",
        "--theme.textColor=#e8eaed"
      ],
      "entrypoint": null,
      "environment": {
        "SAPI_BACKEND_BASE_URL": "http://backend:8080",
        "SAPI_UI_LEGACY_MODES": "0"
      },
      "networks": {
        "sapi-v2-net": null
      },
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile.web"
      },
      "depends_on": {
        "backend": {
          "condition": "service_started",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8501,
          "published": "18501",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "sapi_v2_pgdata": {
      "name": "sapi-h3-518c0b5_sapi_v2_pgdata"
    },
    "sapi_v2_secrets": {
      "name": "sapi-h3-518c0b5_sapi_v2_secrets"
    }
  }
}