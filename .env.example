# ==============================================================================
# S.A.P.I. - INFRAESTRUCTURA DE PERSISTENCIA HÍBRIDA (ENTREGA FINAL 2026)
# ==============================================================================
# Copiar a .env (nunca versionar .env). Todos los valores son ejemplos para
# desarrollo local: ninguno es una credencial real.

# ------------------------------------------------------------------------------
# Arquitectura v2 (SAPI-60): `docker compose up --build`
# Spring Boot (8080) + FastAPI/Modelo D (8000) + PostgreSQL/PostGIS v2 (5432).
# ------------------------------------------------------------------------------
# Base v2 (volumen sapi_v2_pgdata). SAPI_DB_PASSWORD no tiene default en
# docker-compose.yml: sin este valor, Compose no arranca. Cambiarlo antes del
# primer `up`; después queda fijado en el volumen.
SAPI_DB_USER=sapi
SAPI_DB_NAME=sapi_v2
SAPI_DB_PASSWORD=solo-desarrollo-local-cambiar

# Puertos publicados en 127.0.0.1. Cambiarlos solo si ya están ocupados en el
# equipo (por ejemplo, la base legacy de Hito 1 en el 5432).
SAPI_BACKEND_PORT=8080
SAPI_ML_PORT=8000
SAPI_DB_PORT=5432

# Timeouts del backend hacia el servicio ML (un número sin unidad son segundos).
# El read timeout debe superar la duración del scoring.
SAPI_ML_CONNECT_TIMEOUT=2s
SAPI_ML_READ_TIMEOUT=60s

# ------------------------------------------------------------------------------
# Hito 1 legacy (profiles `legacy` y `ops` de docker-compose.yml)
# ------------------------------------------------------------------------------
# Entorno de Desarrollo Local (Docker Compose)
POSTGRES_USER=sapi
POSTGRES_PASSWORD=sapi_secret
POSTGRES_DB=sapi_db
DATABASE_URL=postgresql://sapi:sapi_secret@db-postgis:5432/sapi_db
DATABASE_URL_DIRECT=postgresql://sapi:sapi_secret@db-postgis:5432/sapi_db

# ------------------------------------------------------------------------------
# Producción Streamlit Cloud — Connection Pooler (puerto 6543)
# NOTA: sslmode=require es obligatorio para validación del backend cloud.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.PROJECT:PASS@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Producción Analytics Backend — Conexión directa batch (puerto 5432)
# ------------------------------------------------------------------------------
# DATABASE_URL_DIRECT=postgresql://postgres.PROJECT:PASS@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Credenciales de Telemetría Externa
NASA_FIRMS_API_KEY=your_nasa_firms_key
DMC_API_BASE_URL=https://climatologia.meteochile.gob.cl
CONAF_DATA_URL=https://www.conaf.cl

# DEM (Modelo de Elevación Digital) — Copernicus GLO-30 vía OpenTopography
# Registro gratuito: https://portal.opentopography.org/ -> myOpenTopo -> API Key
OPENTOPO_API_KEY=your_opentopography_key
OPENTOPO_DEM_TYPE=COP30

DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_PREDICTIONS_DIR=data/predictions
MODELS_DIR=models

CACHE_CONTINGENCY_DAYS=7
GRID_CELL_SIZE_KM=1.0
GRID_MAX_CELLS=50

# Modo de datos del dashboard (SAPI-44): demo_seed | postgis_inference
SAPI_DATA_MODE=demo_seed

STREAMLIT_SERVER_PORT=8501
